# Startup banner in Alacritty (must run before the instant prompt below)
[[ -n $ALACRITTY_WINDOW_ID && $SHLVL -eq 1 ]] && source ~/.zsh/splash.zsh

# Powerlevel10k instant prompt. Keep near the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_dups share_history

# Completion and key bindings
autoload -Uz compinit && compinit
bindkey -e

# Editor-style keys
bindkey '^[[1;5D' backward-word        # Ctrl+Left
bindkey '^[[1;5C' forward-word         # Ctrl+Right
bindkey '^H'      backward-kill-word   # Ctrl+Backspace
bindkey '^[[3;5~' kill-word            # Ctrl+Delete
bindkey '^[[3~'   delete-char          # Delete
bindkey '^[[H'    beginning-of-line    # Home
bindkey '^[[1~'   beginning-of-line
bindkey '^[OH'    beginning-of-line
bindkey '^[[F'    end-of-line          # End
bindkey '^[[4~'   end-of-line
bindkey '^[OF'    end-of-line

# Treat / . - as word boundaries for word movement/deletion
WORDCHARS=${WORDCHARS//[\/.-]/}

# Shift+arrows to select text in the command line
source ~/.zsh/plugins/zsh-shift-select/zsh-shift-select.plugin.zsh
# GNOME Terminal swallows Ctrl+Shift+arrows, so also select by word with Alt+Shift+arrows
for km in emacs shift-select; do
  bindkey -M $km '^[[1;4D' shift-select::backward-word
  bindkey -M $km '^[[1;4C' shift-select::forward-word
done

# Colour theme (dark or light), shared with ~/.p10k.zsh; switch with `theme dark|light`
export DOTFILES_THEME
[[ -r ~/.config/dotfiles/theme ]] && DOTFILES_THEME=$(<~/.config/dotfiles/theme)
[[ $DOTFILES_THEME == light ]] || DOTFILES_THEME=dark

# fzf colours, also used by the fzf-tab popup
if [[ $DOTFILES_THEME == light ]]; then
  export FZF_DEFAULT_OPTS='--color=light,bg+:#e3eef7,hl:#0b7fc4,hl+:#0b7fc4,pointer:#d93636,marker:#12875c,prompt:#0b7fc4,info:#7e92a5'
else
  export FZF_DEFAULT_OPTS='--color=dark,bg+:#22313a,hl:#15a6f0,hl+:#5cc0f5,pointer:#fb7c7c,marker:#4cd9a4,prompt:#15a6f0,info:#6f8896'
fi
zstyle ':fzf-tab:*' use-fzf-default-opts yes

# Tab completion as a searchable fzf popup (must load after compinit, before the two below)
source ~/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
# Grey history suggestions while typing; accept with Right arrow or End
[[ $DOTFILES_THEME == light ]] && ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#8999aa' || ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#5f7581'
source ~/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
# Colour commands as you type (should stay the last plugin loaded)
source ~/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# PATH (e.g. claude installs to ~/.local/bin)
[[ -d ~/.local/bin ]] && path=(~/.local/bin $path)

source ~/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# .NET global tools
export PATH="$PATH:$HOME/.dotnet/tools"

# SQL Server tools (sqlcmd, bcp)
export PATH="$PATH:/opt/mssql-tools18/bin"

# Switch Alacritty, zellij, the prompt and plugins between Zorin Dark and Zorin Light
theme() {
  if [[ $1 != (dark|light) ]]; then
    print "usage: theme dark|light (current: $DOTFILES_THEME)"
    return 1
  fi
  mkdir -p ~/.config/dotfiles && print $1 > ~/.config/dotfiles/theme
  ln -sfn ~/.config/alacritty/themes/zorin-$1.toml ~/.config/alacritty/theme.toml
  touch ~/.config/alacritty/alacritty.toml  # nudge Alacritty's live reload
  exec zsh
}

# Start Claude Code in ~/git when launched from $HOME
claude() {
  if [[ "$PWD" == "$HOME" ]]; then
    (cd "$HOME/git" && command claude "$@")
  else
    command claude "$@"
  fi
}
