// GitHub Light, matching the Alacritty palette and the Powerlevel10k rainbow segments
// (active tab/frame use the same blue as the p10k directory segment).
themes {
    github-light {
        text_unselected {
            base 36 41 47
            background 246 248 250
            emphasis_0 188 76 0
            emphasis_1 9 105 218
            emphasis_2 26 127 55
            emphasis_3 130 80 223
        }
        text_selected {
            base 36 41 47
            background 208 215 222
            emphasis_0 188 76 0
